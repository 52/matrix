#!/bin/sh
set -eu

# Setup hook for x86_64 Linux systems.
# Executed only on x86_64-linux platforms.
__setup_x86_64-linux() {
    :
}

# Setup hook for x86_64 macOS systems.
# Executed only on x86_64-darwin platforms.
__setup_x86_64-darwin() {
    :
}

# Setup hook for ARM64 Linux systems.
# Executed only on aarch64-linux platforms.
__setup_aarch64-linux() {
    :
}

# Setup hook for ARM64 macOS systems.
# Executed only on aarch64-darwin platforms.
__setup_aarch64-darwin() {
    :
}

# Setup hook for all Linux systems.
# Executed on any Linux platform regardless of architecture.
__setup_linux() {
    :
}

# Setup hook for all macOS systems.
# Executed on any Darwin platform regardless of architecture.
__setup_darwin() {
    :
}

__platform_run_os "linux"  __setup_linux
__platform_run_os "darwin" __setup_darwin

__platform_run "x86_64-linux"   __setup_x86_64-linux
__platform_run "x86_64-darwin"  __setup_x86_64-darwin

__platform_run "aarch64-linux"  __setup_aarch64-linux
__platform_run "aarch64-darwin" __setup_aarch64-darwin

# Primary entry point.
# Executed on all platforms after the setup hooks complete.
__main__() {
    echo "Hello, world!"
}

__main__
