#!/bin/sh
set -eu

ROOT="$(cd "$(dirname "${0}")/.." && pwd)"

. "${ROOT}/lib/platform.sh"
. "${ROOT}/lib/trace.sh"

if [ -z "${1:-}" ]; then
    trace_error "Missing target argument"
    exit 1
fi

TARGET="${1}"
TARGET_DIR="${ROOT}/targets/${TARGET}"

if [ ! -f "${TARGET_DIR}/config" ]; then
    trace_error "Configuration file not found: ${TARGET_DIR}/config"
    exit 1
fi

if [ ! -r "${TARGET_DIR}/main" ]; then
    trace_error "Main script not found: ${TARGET_DIR}/main"
    exit 1
fi

. "${TARGET_DIR}/config"

if ! command -v git >/dev/null; then
    trace_error "Required dependency not found: git"
    exit 1
fi

WORK_DIR="/tmp/matrix-$(echo "${TARGET}" | tr '/' '-')-${$}"
mkdir -p "${WORK_DIR}"

trap 'case "${WORK_DIR}" in /tmp/matrix-*) rm -rf "${WORK_DIR}";; esac' EXIT

trace_info "Cloning ${REPO}..."
git clone --quiet "${REPO}" "${WORK_DIR}"
cd "${WORK_DIR}"
git checkout --quiet "${REF}"

if [ -d "${TARGET_DIR}/patches" ]; then
    for patch in "${TARGET_DIR}/patches/"*.patch; do
        [ -e "${patch}" ] || continue
        trace_info "Applying ${patch##*/}"
        git apply "${patch}"
    done
fi

trace_info "Executing target: ${TARGET}"
( . "${TARGET_DIR}/main" )
