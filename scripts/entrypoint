#!/bin/sh
set -eu

if [ -z "${1:-}" ]; then
    echo "error: missing target argument" >&2
    exit 1
fi

ROOT="$(cd "$(dirname "${0}")/.." && pwd)"

. "${ROOT}/lib/platform.sh"
. "${ROOT}/lib/trace.sh"

TARGET="${1}"
TARGET_DIR="${ROOT}/targets/${TARGET}"

if [ ! -f "${TARGET_DIR}/config" ]; then
    echo "error: config not found in ${TARGET_DIR}" >&2
    exit 1
fi

if [ ! -r "${TARGET_DIR}/main" ]; then
    echo "error: main not found in ${TARGET_DIR}" >&2
    exit 1
fi

. "${TARGET_DIR}/config"

if ! command -v git >/dev/null; then
    echo "error: git not found" >&2
    exit 1
fi

WORK_DIR="/tmp/matrix-$(echo "${TARGET}" | tr '/' '-')-${$}"
mkdir -p "${WORK_DIR}"

trap 'case "${WORK_DIR}" in /tmp/matrix-*) rm -rf "${WORK_DIR}";; esac' EXIT

echo "Cloning ${REPO}..."
git clone "${REPO}" "${WORK_DIR}" && cd "${WORK_DIR}"
git checkout "${REF}"

if [ -d "${TARGET_DIR}/patches" ]; then
    for patch in "${TARGET_DIR}/patches/"*.patch; do
        [ -e "${patch}" ] || continue
        git apply "${patch}"
    done
fi

( . "${TARGET_DIR}/main" )
